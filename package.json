{
  "name": "schalkneethling.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "setup:playwright": "pnpm exec playwright install chromium",
    "build": "pnpm run generate:og && astro build",
    "generate:og": "node scripts/generate-og-cards.mjs",
    "standard-site:generate": "node scripts/generate-standard-site-records.ts",
    "standard-site:lexicons:build": "lex build --clear --index-file --import-ext .ts",
    "standard-site:lexicons:check": "lex install --ci && pnpm standard-site:lexicons:build",
    "standard-site:sync": "varlock run -- node scripts/sync-standard-site-records.ts",
    "standard-site:validate": "pnpm run build && node scripts/validate-standard-site-build.ts",
    "refresh:project-docs": "node scripts/refresh-project-doc-cache.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test:a11y": "playwright test",
    "a11y:viewer": "axe-aggregate-viewer ./full-report.json",
    "a11y:viewer:standalone": "axe-aggregate-viewer ./full-report.json --standalone",
    "test:unit": "pnpm standard-site:lexicons:build && vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@atproto/common-web": "^0.5.6",
    "@atproto/lex": "^0.3.0",
    "@atproto/lex-client": "^0.3.0",
    "@atproto/lex-password-session": "^0.1.8",
    "@atproto/syntax": "^0.7.2",
    "@lucide/astro": "^1.26.0",
    "@schalkneethling/masonry-gridlanes-wc": "^0.1.0",
    "astro": "^7.1.3",
    "astro-embed": "^0.13.1",
    "typescript": "^7.0.2",
    "varlock": "^1.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@schalkneethling/axe-aggregate-reporter": "0.6.2",
    "@schalkneethling/opengraph-cards-maker": "^0.3.0",
    "@varlock/1password-plugin": "^2.0.0",
    "axe-core": "^4.12.1",
    "devalue": "^5.8.2",
    "linkedom": "^0.18.13",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.9.0"
}
