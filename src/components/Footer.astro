---
import Social from "./Social.astro";
import WinterFooterHorizon from "./Footer/WinterFooterHorizon.astro";

const socialLinks = [
  {
    linkLabel: "Collaborate with me on GitHub",
    url: "https://github.com/schalkneethling",
  },
  {
    linkLabel: "Learn with me on YouTube",
    url: "https://www.youtube.com/channel/UCaIC2hpfo9av8-R7g9qE2sw",
  },
  {
    linkLabel: "Let's chat on BlueSky",
    url: "https://bsky.app/profile/schalkneethling.com",
  },
  {
    linkLabel: "Connect with me on LinkedIn",
    url: "https://www.linkedin.com/in/schalkneethling/",
  },
];
---

<footer class="page-footer">
  <WinterFooterHorizon />
  <div class="footer-panel">
    <div class="footer-content">
      <nav aria-label="Social links" class="social-nav">
        <ul class="social-links">
          {
            socialLinks.map((link) => (
              <li>
                <Social {...link} />
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="footer-copyright">
        Copyright © {new Date().getFullYear()} - Schalk Neethling
      </p>
    </div>
  </div>
</footer>

<style>
  .page-footer {
    display: flex;
    flex-direction: column;
    inline-size: 100vw;
    margin-block-start: auto;
    margin-inline: calc(50% - 50vw);
    position: relative;
  }

  .footer-panel {
    background:
      linear-gradient(
        180deg,
        var(--color-footer-background) 0%,
        var(--color-footer-background-end) 100%
      );
    order: -1;
    padding-block: var(--size-48);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--size-24);
    max-inline-size: 75rem;
    margin-inline: auto;
    padding-inline: var(--size-16);
    text-align: center;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--size-16);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .social-links a {
    display: inline-block;
    padding: var(--size-8) var(--size-16);
    background-color: var(--color-surface-elevated);
    border: var(--size-1) solid var(--color-border);
    border-radius: var(--border-radius-default);
    color: var(--color-text);
    font-size: var(--typography-size-small);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .social-links a:hover,
  .social-links a:focus {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-background);
  }

  .social-links a:focus-visible {
    outline: var(--size-2) solid var(--color-accent);
    outline-offset: var(--size-4);
  }

  .footer-attribution,
  .footer-copyright {
    color: var(--color-text);
    font-size: var(--typography-size-small);
    margin: 0;
  }

  .footer-attribution a {
    color: var(--color-link);
  }

  @media (min-width: 48rem) {
    .footer-panel {
      background: linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--color-footer-background) 58%, transparent) 38%,
        var(--color-footer-background) 100%
      );
      inset-block-end: 0;
      inset-inline: 0;
      order: initial;
      padding-block: clamp(7rem, 12vw, 11rem) var(--size-32);
      position: absolute;
      z-index: 1;
    }

    .footer-content {
      padding-inline: var(--size-32);
    }

    .social-links {
      gap: var(--size-24);
    }
  }
</style>
