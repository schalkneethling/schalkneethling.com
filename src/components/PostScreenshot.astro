---
/**
 * Renders a post screenshot that was captured at twice its display size.
 *
 * The source is imported from `src/assets/posts/<slug>/`, so Astro can
 * generate AVIF as the preferred format and WebP as the fallback, each at
 * 1x and 2x pixel density.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  /** The imported image, captured at twice its intended display width. */
  src: ImageMetadata;
  alt: string;
};

const { src, alt } = Astro.props;
const displayWidth = Math.round(src.width / 2);
---

<Picture
  src={src}
  alt={alt}
  width={displayWidth}
  densities={[1, 2]}
  formats={["avif"]}
  fallbackFormat="webp"
/>
